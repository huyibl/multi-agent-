# 复制到 Streamlit Cloud → App settings → Secrets
# 本地也可复制为 secrets.toml（已在 .gitignore）

DEEPSEEK_API_KEY = "sk-xxx"
DEEPSEEK_BASE_URL = "https://api.deepseek.com"
DEEPSEEK_MODEL = "deepseek-v4-flash"

DASHSCOPE_API_KEY = "sk-xxx"
EMBEDDING_PROVIDER = "dashscope"
EMBEDDING_MODEL = "text-embedding-v4"
EMBEDDING_DIMENSION = "1024"

PLANNER_USE_LLM = "auto"
REVIEWER_USE_LLM = "auto"
RETRIEVAL_MERGE_QUERIES = "true"
MAX_REVIEW_RETRIES = "2"

ANONYMIZED_TELEMETRY = "False"

# Cloud Demo 防刷（Cloud 默认开启；本地默认关闭）
# DEMO_RATE_LIMIT = "1"
DEMO_SESSION_LIMIT = "10"
DEMO_DAILY_LIMIT = "100"
DEMO_COOLDOWN_SEC = "15"
