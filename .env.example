# LLM (DeepSeek - OpenAI compatible)
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Embedding (DashScope / local)
DASHSCOPE_API_KEY=your_api_key_here
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_PROVIDER=dashscope
EMBEDDING_DIMENSION=1024
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3

# Vector store
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=health_knowledge

# RAG settings
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5

# LangSmith (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls-xxx
LANGCHAIN_PROJECT=health-assistant

# App
LOG_LEVEL=INFO
MAX_REVIEW_RETRIES=2

# Performance / cost optimization (optimized_v1)
PLANNER_USE_LLM=auto
REVIEWER_USE_LLM=auto
RETRIEVAL_MERGE_QUERIES=true
